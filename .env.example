# Copy to .env.local and fill in. Never commit .env.local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Supabase: Project Settings > API Keys (the URL and the publishable key, sb_publishable_...).
# Both are meant to be public; the secret key never goes in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional overrides
# CLIP_MODEL=claude-sonnet-5-5
# Where the web app and worker keep uploads, transcripts and clips (default: ./data)
# DATA_DIR=
